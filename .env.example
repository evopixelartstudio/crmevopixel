# ========================================================
# EVOCRM - Variáveis de Ambiente de Produção
# Copie este arquivo para .env no servidor VPS Hostinger
# Exemplo: cp .env.example .env
# ========================================================

# Porta e Ambiente da Aplicação
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0

# Domínio da Aplicação
DOMAIN=crmevopixel.cloud

# Rede externa do Traefik no VPS (padrão: traefik_network)
# Alinhe com o nome da rede Docker utilizada pelo container do Traefik (ex: traefik_network, traefik-net, proxy ou web)
TRAEFIK_NETWORK=traefik_network

# Conexão com o Supabase (PostgreSQL)
# Obtenha os valores no painel do Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=TODO_CONFIGURAR
NEXT_PUBLIC_SUPABASE_ANON_KEY=TODO_CONFIGURAR

# WhatsApp via Evolution GO ou API v2 (apenas no servidor, sem NEXT_PUBLIC)
EVOLUTION_API_URL=https://evolution-go-nk3u.srv1956040.hstgr.cloud
EVOLUTION_PROVIDER=go
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=evocrm
# Chave forte e exclusiva, informada na tela WhatsApp para acessar as conversas
CRM_WHATSAPP_ACCESS_TOKEN=
# Compartilhada por Rabisco e WhatsApp. Nunca usar prefixo NEXT_PUBLIC.
CRM_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
EVOLUTION_WEBHOOK_URL=https://crmevopixel.cloud/api/whatsapp/webhook
